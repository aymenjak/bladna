{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@bladna/database": ["./packages/database/src/index.ts"],
      "@bladna/validation": ["./packages/validation/src/index.ts"],
      "@bladna/types": ["./packages/types/src/index.ts"],
      "@bladna/domain": ["./packages/domain/src/index.ts"],
      "@bladna/auth": ["./packages/auth/src/index.ts"],
      "@bladna/utils": ["./packages/utils/src/index.ts"],
      "@bladna/ui": ["./packages/ui/src/index.ts"],
      "@bladna/config/*": ["./packages/config/*"]
    }
  },
  "include": [
    "apps/web/src/**/*",
    "apps/web/*.ts",
    "apps/web/*.mjs",
    "packages/*/src/**/*",
    "packages/*/prisma.config.ts",
    "scripts/**/*",
    "tests/e2e/**/*",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/.next/**", "packages/database/src/generated/**"]
}
