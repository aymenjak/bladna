{
  "name": "bladna",
  "private": true,
  "version": "0.1.0",
  "description": "BLADNA — Algeria-first volunteer identity, verified experience, opportunities, organization SaaS, CSR & international volunteering platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run dev --workspace @bladna/web",
    "build": "npm run build --workspace @bladna/web",
    "start": "npm run start --workspace @bladna/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace @bladna/database",
    "db:migrate": "npm run db:migrate --workspace @bladna/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @bladna/database",
    "db:seed": "npm run db:seed --workspace @bladna/database",
    "db:studio": "npm run db:studio --workspace @bladna/database",
    "db:migration:diff": "npm run db:migration:diff --workspace @bladna/database",
    "check:routes": "tsx scripts/check-routes.ts",
    "check:api-docs": "tsx scripts/check-api-docs.ts",
    "check": "npm run check:routes && npm run check:api-docs",
    "build:map-geo": "tsx scripts/geo/build-map-geo.ts",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
