# BLADNA — environment configuration
#
# Copy to `.env` and fill in real values. Never commit real secrets.
# Authoritative source: apps/web/src/server/env.ts (typed access) plus the
# Prisma datasource in packages/database/prisma/schema.prisma.
#
# Legend: [required] must be set for the app to run · [optional] has a safe
# default (default shown) · [dev] development-only convenience.

# ── Application ──────────────────────────────────────────────────────────
NODE_ENV=development                          # [optional] development | test | production (default: development)
APP_NAME=BLADNA                               # [optional] display name (default: BLADNA)
APP_URL=http://localhost:3000                 # [optional] canonical base URL, used for origin checks (default: http://localhost:3000)
PUBLIC_APP_URL=http://localhost:3000          # [optional] public base URL for emails/QR links; falls back to APP_URL
POLICY_VERSION=2026-01-01                     # [optional] privacy policy version recorded on consent rows (default: 2026-01-01)
DEMO_MODE=false                               # [optional] "true" shows the demo banner / allows seeded demo data / renders the demo-access
                                              #            card (demo accounts + password + LIVE 2FA codes) under the login form.
                                              #            [dev] ONLY — never enable on a deployment with real users (default: false)
TRUST_PROXY=false                             # [optional] "true" honours x-forwarded-for for client IPs behind a proxy (default: false)
ERROR_MONITOR_DSN=                            # [optional] error-monitoring DSN (default: empty)
# Comma-separated feature flags forced ON, e.g. FEATURE_FLAGS=CAMPAIGNS_ENABLED
FEATURE_FLAGS=
# Per-flag env kill switches (see apps/web/src/server/infra/flags.ts):
# FEATURE_<FLAG_KEY>=true|false wins over FEATURE_FLAGS and the database rows,
# e.g. FEATURE_MAINTENANCE_MODE=true

# ── Database (PostgreSQL) [required] ─────────────────────────────────────
# Prisma datasource url — env("DATABASE_URL") in schema.prisma. Required as
# soon as a query executes (placeholder matches docker-compose.yml).
DATABASE_URL=postgresql://bladna:change-me@localhost:5432/bladna
# Optional: verbose Prisma query-engine debug logging (read by the generated
# Prisma client runtime, packages/database/src/generated).
DEBUG=

# ── Auth / sessions ──────────────────────────────────────────────────────
# [required] HMAC secret for access JWTs — minimum 32 characters.
# Generate: openssl rand -base64 48
AUTH_SECRET=change-me-64-chars-minimum-long-random-string-for-auth-secret-000
SESSION_SECRET=                               # [optional] separate secret for sessions/QR; falls back to AUTH_SECRET
ACCESS_TOKEN_TTL=900                          # [optional] access JWT lifetime in seconds (default: 900)
REFRESH_TOKEN_TTL=2592000                     # [optional] refresh/session lifetime in seconds (default: 30 days)
COOKIE_DOMAIN=                                # [optional] cookie domain; empty = host-only cookies
QR_SIGNING_SECRET=                            # [optional] HMAC secret for signed QR payloads; falls back to SESSION_SECRET then AUTH_SECRET

# ── Cache / queue ────────────────────────────────────────────────────────
REDIS_URL=                                    # [optional] empty = in-process queue/cache adapters (fine for single-node dev)

# ── Storage ──────────────────────────────────────────────────────────────
STORAGE_DRIVER=local                          # [optional] "local" (implemented) | "s3" (not wired in this build → CONFIG_ERROR)
STORAGE_LOCAL_DIR=./var/storage               # [optional] local upload root (default: ./var/storage)

# ── Email ────────────────────────────────────────────────────────────────
EMAIL_DRIVER=console                          # [optional] "console" (writes .eml files, default) | "smtp" (not wired in this build)
EMAIL_FROM="BLADNA <no-reply@bladna.local>"   # [optional] From header (default: BLADNA <no-reply@bladna.local>)
EMAIL_FILE_DIR=./var/emails                   # [optional] where the console driver writes rendered .eml files
SMTP_HOST=                                    # [optional] read when EMAIL_DRIVER=smtp (transport not wired in this build)
SMTP_PORT=587                                 # [optional] (default: 587)
SMTP_USER=                                    # [optional]
SMTP_PASS=                                    # [optional]

# ── Payments ─────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=bank_transfer                # [optional] bank_transfer (default) | free; stripe/paypal/cib/edahabia need credentials
STRIPE_SECRET_KEY=                            # [optional] only read when PAYMENT_PROVIDER=stripe
PAYPAL_CLIENT_ID=                             # [optional] only read when PAYMENT_PROVIDER=paypal
PAYPAL_CLIENT_SECRET=                         # [optional] only read when PAYMENT_PROVIDER=paypal

# ── Maps ─────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=                          # [optional]
MAP_PUBLIC_KEY=                               # [optional]
MAP_PROVIDER=                                 # [optional] provider key for the map abstraction (default: none)

# ── AI (optional; rule-based local providers when unset) ─────────────────
AI_PROVIDER=                                  # [optional] empty = local rule-based providers (default: empty)
AI_BASE_URL=                                  # [optional] base URL for a configured provider
AI_API_KEY=                                   # [optional] credentials for a configured provider
# GDPR gate: must be explicitly "true" before personal documents are sent to
# an external AI provider (default: false).
AI_SEND_DOCUMENTS=false
