// BLADNA — Prisma schema
// PostgreSQL. UUID primary keys. Audit-sensitive records are append-only or soft-deleted.
// Conventions:
//   * every important entity: id, createdAt, updatedAt
//   * localized fields: nameAr / nameFr / nameEn (or titleAr / ...)
//   * history tables are append-only (never updated once completed)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

